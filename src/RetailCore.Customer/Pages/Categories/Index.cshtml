@page
@model RetailCore.Customer.Pages.Categories.IndexModel
@{
    ViewData["Title"] = "Categories";
}

@functions {
    public IDictionary<string, string> BuildRoute(int? p = null, string? keyword = null)
    {
        var route = new Dictionary<string, string>();

        if (p.HasValue && p.Value > 1)
        {
            route["p"] = p.Value.ToString();
        }

        if (!string.IsNullOrWhiteSpace(keyword))
        {
            route["keyword"] = keyword;
        }

        return route;
    }
}

<section class="py-5">
    <div class="container-lg">
        <div class="mb-4">
            <div>
                <h1 class="display-5 fw-bold mb-2">Categories</h1>
                <p class="text-muted mb-0">Browse product families and jump straight into matching products.</p>
            </div>
        </div>

        <form method="get" asp-page="/Categories/Index" class="d-flex gap-2 mb-5">
            <input name="keyword" value="@Model.Keyword" class="form-control" placeholder="Search categories..." />
            <button class="btn btn-primary-gradient" type="submit">Search</button>
        </form>

        @if (Model.Categories.Any())
        {
            <div class="row g-3">
                @foreach (var category in Model.Categories)
                {
                    <div class="col-6 col-md-4 col-lg-3">
                        <a asp-page="/Products/Index" asp-route-category="@category.Slug" class="text-decoration-none">
                            <div class="card card-hover text-center p-4 h-100 border-0 shadow-sm">
                                <div class="mb-3">
                                    <div class="rounded-circle bg-primary bg-opacity-10 d-inline-flex align-items-center justify-content-center"
                                         style="width: 70px; height: 70px;">
                                        <i class="fas fa-layer-group text-primary fs-3"></i>
                                    </div>
                                </div>
                                <h6 class="fw-semibold text-dark mb-1">@category.Name</h6>
                                @if (!string.IsNullOrWhiteSpace(category.Description))
                                {
                                    <small class="text-muted">@category.Description</small>
                                }
                            </div>
                        </a>
                    </div>
                }
            </div>

            @if (Model.TotalPages > 1)
            {
                <nav aria-label="Categories pagination" class="mt-5">
                    <ul class="pagination justify-content-center">
                        <li class="page-item @(Model.HasPreviousPage ? "" : "disabled")">
                            <a class="page-link" asp-page="/Categories/Index"
                               asp-all-route-data="BuildRoute(Model.CurrentPage - 1, Model.Keyword)">Previous</a>
                        </li>
                        @for (var i = 1; i <= Model.TotalPages; i++)
                        {
                            <li class="page-item @(i == Model.CurrentPage ? "active" : "")">
                                <a class="page-link" asp-page="/Categories/Index"
                                   asp-all-route-data="BuildRoute(i, Model.Keyword)">@i</a>
                            </li>
                        }
                        <li class="page-item @(Model.HasNextPage ? "" : "disabled")">
                            <a class="page-link" asp-page="/Categories/Index"
                               asp-all-route-data="BuildRoute(Model.CurrentPage + 1, Model.Keyword)">Next</a>
                        </li>
                    </ul>
                </nav>
            }
        }
        else
        {
            <div class="text-center py-5">
                <i class="fas fa-inbox display-6 text-muted mb-3"></i>
                <p class="text-muted fs-5">No categories found.</p>
            </div>
        }
    </div>
</section>
