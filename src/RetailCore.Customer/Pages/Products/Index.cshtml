@page
@model RetailCore.Customer.Pages.Products.IndexModel
@{
    ViewData["Title"] = "Products";
}

@functions {
    public IDictionary<string, string> BuildRoute(
        int? p = null,
        string? category = null,
        string? brand = null,
        string? keyword = null)
    {
        var route = new Dictionary<string, string>();

        if (p.HasValue && p.Value > 1)
        {
            route["p"] = p.Value.ToString();
        }

        if (!string.IsNullOrWhiteSpace(category))
        {
            route["category"] = category;
        }

        if (!string.IsNullOrWhiteSpace(brand))
        {
            route["brand"] = brand;
        }

        if (!string.IsNullOrWhiteSpace(keyword))
        {
            route["keyword"] = keyword;
        }

        return route;
    }
}

<section class="py-5">
    <div class="container-lg">
        <div class="mb-5">
            <h1 class="display-5 fw-bold mb-2">Our Products</h1>
            <p class="text-muted">Discover premium tech accessories for every need.</p>
        </div>

        <div class="row g-5">
            <div class="col-lg-3">
                <aside class="card position-sticky sticky-card" style="top: 20px">
                    <div class="card-body">
                        @if (Model.SelectedCategorySlug != null || Model.SelectedBrandSlug != null || !string.IsNullOrWhiteSpace(Model.Keyword))
                        {
                            <a asp-page="/Products/Index" class="btn btn-outline-secondary w-100 mb-4">
                                Clear Filters
                            </a>
                        }

                        <div class="mb-4">
                            <h5 class="fw-bold mb-3">Categories</h5>
                            <div class="list-group list-group-flush overflow-auto" style="max-height: 18rem;">
                                <a asp-page="/Products/Index"
                                   asp-all-route-data="BuildRoute(1, null, Model.SelectedBrandSlug, Model.Keyword)"
                                   class="list-group-item list-group-item-action @(Model.SelectedCategorySlug == null ? "active" : "")">
                                    All Products
                                </a>
                                @foreach (var category in Model.Categories)
                                {
                                    <a asp-page="/Products/Index"
                                       asp-all-route-data="BuildRoute(1, category.Slug, Model.SelectedBrandSlug, Model.Keyword)"
                                       class="list-group-item list-group-item-action @(Model.SelectedCategorySlug == category.Slug ? "active" : "")">
                                        @category.Name
                                    </a>
                                }
                            </div>
                        </div>

                        <hr />

                        <div>
                            <h5 class="fw-bold mb-3">Brands</h5>
                            <div class="list-group list-group-flush overflow-auto" style="max-height: 18rem;">
                                <a asp-page="/Products/Index"
                                   asp-all-route-data="BuildRoute(1, Model.SelectedCategorySlug, null, Model.Keyword)"
                                   class="list-group-item list-group-item-action @(Model.SelectedBrandSlug == null ? "active" : "")">
                                    All Brands
                                </a>
                                @foreach (var brand in Model.Brands)
                                {
                                    <a asp-page="/Products/Index"
                                       asp-all-route-data="BuildRoute(1, Model.SelectedCategorySlug, brand.Slug, Model.Keyword)"
                                       class="list-group-item list-group-item-action @(Model.SelectedBrandSlug == brand.Slug ? "active" : "")">
                                        @brand.Name
                                    </a>
                                }
                            </div>
                        </div>
                    </div>
                </aside>
            </div>

            <div class="col-lg-9">
                <div class="d-flex flex-column flex-md-row align-items-md-end justify-content-between gap-3 mb-4">
                    <div>
                        <h2 class="h4 fw-bold mb-1">Shop Products</h2>
                        @if (!string.IsNullOrWhiteSpace(Model.Keyword))
                        {
                            <p class="text-muted mb-0">Search results for "@Model.Keyword"</p>
                        }
                    </div>

                    <form method="get" asp-page="/Products/Index" class="d-flex gap-2">
                        @if (Model.SelectedCategorySlug != null)
                        {
                            <input type="hidden" name="category" value="@Model.SelectedCategorySlug" />
                        }

                        @if (Model.SelectedBrandSlug != null)
                        {
                            <input type="hidden" name="brand" value="@Model.SelectedBrandSlug" />
                        }

                        <input name="keyword"
                               value="@Model.Keyword"
                               class="form-control"
                               placeholder="Search products..." />
                        <button type="submit" class="btn btn-primary-gradient">
                            Search
                        </button>
                    </form>
                </div>

                @if (Model.Products.Any())
                {
                    <div class="row g-4">
                        @foreach (var product in Model.Products)
                        {
                            <div class="col-md-6 col-lg-4">
                                <partial name="Shared/ProductCard" model="product" />
                            </div>
                        }
                    </div>

                    <div class="d-flex justify-content-end my-4">
                        @{
                            var startItem = (Model.CurrentPage - 1) * Model.PageSize + 1;
                            var endItem = Math.Min(Model.CurrentPage * Model.PageSize, Model.TotalCount);
                        }
                        <small class="text-muted">
                            Showing @startItem - @endItem of @Model.TotalCount products
                        </small>
                    </div>

                    @if (Model.TotalPages > 1)
                    {
                        <nav aria-label="Page navigation" class="mt-3">
                            <ul class="pagination justify-content-center">
                                <li class="page-item @(Model.HasPreviousPage ? "" : "disabled")">
                                    @if (Model.HasPreviousPage)
                                    {
                                        <a class="page-link"
                                           asp-page="/Products/Index"
                                           asp-all-route-data="BuildRoute(Model.CurrentPage - 1, Model.SelectedCategorySlug, Model.SelectedBrandSlug, Model.Keyword)">
                                            Previous
                                        </a>
                                    }
                                    else
                                    {
                                        <span class="page-link">Previous</span>
                                    }
                                </li>

                                @{
                                    var startPage = Math.Max(1, Model.CurrentPage - 2);
                                    var endPage = Math.Min(Model.TotalPages, Model.CurrentPage + 2);
                                }

                                @if (startPage > 1)
                                {
                                    <li class="page-item">
                                        <a class="page-link"
                                           asp-page="/Products/Index"
                                           asp-all-route-data="BuildRoute(1, Model.SelectedCategorySlug, Model.SelectedBrandSlug, Model.Keyword)">
                                            1
                                        </a>
                                    </li>

                                    if (startPage > 2)
                                    {
                                        <li class="page-item disabled">
                                            <span class="page-link">...</span>
                                        </li>
                                    }
                                }

                                @for (var i = startPage; i <= endPage; i++)
                                {
                                    if (i == Model.CurrentPage)
                                    {
                                        <li class="page-item active" aria-current="page">
                                            <span class="page-link">
                                                @i <span class="visually-hidden">(current)</span>
                                            </span>
                                        </li>
                                    }
                                    else
                                    {
                                        <li class="page-item">
                                            <a class="page-link"
                                               asp-page="/Products/Index"
                                               asp-all-route-data="BuildRoute(i, Model.SelectedCategorySlug, Model.SelectedBrandSlug, Model.Keyword)">
                                                @i
                                            </a>
                                        </li>
                                    }
                                }

                                @if (endPage < Model.TotalPages)
                                {
                                    if (endPage < Model.TotalPages - 1)
                                    {
                                        <li class="page-item disabled">
                                            <span class="page-link">...</span>
                                        </li>
                                    }

                                    <li class="page-item">
                                        <a class="page-link"
                                           asp-page="/Products/Index"
                                           asp-all-route-data="BuildRoute(Model.TotalPages, Model.SelectedCategorySlug, Model.SelectedBrandSlug, Model.Keyword)">
                                            @Model.TotalPages
                                        </a>
                                    </li>
                                }

                                <li class="page-item @(Model.HasNextPage ? "" : "disabled")">
                                    @if (Model.HasNextPage)
                                    {
                                        <a class="page-link"
                                           asp-page="/Products/Index"
                                           asp-all-route-data="BuildRoute(Model.CurrentPage + 1, Model.SelectedCategorySlug, Model.SelectedBrandSlug, Model.Keyword)">
                                            Next
                                        </a>
                                    }
                                    else
                                    {
                                        <span class="page-link">Next</span>
                                    }
                                </li>
                            </ul>
                        </nav>
                    }
                }
                else
                {
                    <div class="text-center py-5">
                        <i class="fas fa-inbox display-6 text-muted mb-3"></i>
                        <p class="text-muted fs-5">No products found.</p>
                        <a asp-page="/Products/Index" class="btn btn-primary-gradient">View all products</a>
                    </div>
                }
            </div>
        </div>
    </div>
</section>
