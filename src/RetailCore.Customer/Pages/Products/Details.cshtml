@page "{slug}"
@using System.Text.Json
@using RetailCore.Shared.Enums
@model RetailCore.Customer.Pages.Products.DetailsModel

@{
    ViewData["Title"] = Model.Product?.Name;

    var product = Model.Product;

    if (product == null)
    {
        <div class="text-center py-5">
            <p class="text-muted fs-5">Product not found.</p>
        </div>
        return;
    }

    var selectedVariant =
        product.Variants.FirstOrDefault(v => v.Status == ProductVariantStatus.Active && v.Stock > 0)
        ?? product.Variants.FirstOrDefault();

    var selectedImages = selectedVariant?.Images
        .OrderBy(i => i.SortOrder)
        .ToList() ?? [];

    var allImages = product.Variants
        .SelectMany(v => v.Images)
        .OrderBy(i => i.SortOrder)
        .ToList();

    var initialImages = selectedImages.Any() ? selectedImages : allImages;
    var placeholderUrl = Url.Content("~/assets/images/placeholder.svg");
    var mainImage = initialImages.FirstOrDefault(i => i.IsPrimary)?.Url
        ?? initialImages.FirstOrDefault()?.Url
        ?? placeholderUrl;

    var selectedAttributeValueIds = selectedVariant?.Attributes
        .Select(a => a.AttributeValueId)
        .ToHashSet() ?? [];

    var variantData = product.Variants.Select(variant => new
    {
        id = variant.Id,
        name = variant.Name,
        sku = variant.Sku,
        price = variant.Price,
        compareAtPrice = variant.CompareAtPrice,
        discountPercentage = variant.DiscountPercentage,
        stock = variant.Stock,
        status = variant.Status.ToString(),
        isActive = variant.Status == ProductVariantStatus.Active,
        isPurchasable = variant.Stock > 0,
        attributes = variant.Attributes.Select(attribute => new
        {
            attributeId = attribute.AttributeId,
            attributeName = attribute.AttributeName,
            attributeValueId = attribute.AttributeValueId,
            attributeValue = attribute.AttributeValue
        }),
        images = variant.Images
            .OrderBy(image => image.SortOrder)
            .Select(image => new
            {
                url = image.Url,
                isPrimary = image.IsPrimary,
                sortOrder = image.SortOrder
            })
    });

    var variantsJson = JsonSerializer.Serialize(variantData);
}

<section class="py-5">
    <div class="container-lg">
        <nav aria-label="breadcrumb" class="mb-4">
            <ol class="breadcrumb">
                <li class="breadcrumb-item">
                    <a asp-page="/Index">Home</a>
                </li>
                <li class="breadcrumb-item">
                    <a asp-page="/Products/Index">Products</a>
                </li>
                <li class="breadcrumb-item active">@product.Name</li>
            </ol>
        </nav>

        <div class="row g-5">
            <div class="col-lg-5">
                <div class="mb-3 rounded overflow-hidden bg-light" style="height: 28rem;">
                    <img id="main-product-image" src="@mainImage" alt="@product.Name" class="w-100 h-100"
                         style="object-fit: cover;" onerror="this.onerror=null; this.src='@placeholderUrl';" />
                </div>

                <div class="position-relative">
                    <button type="button"
                            class="btn btn-light position-absolute top-50 start-0 translate-middle-y shadow-sm"
                            style="z-index: 1;" onclick="scrollGallery(-1)" aria-label="Previous image">
                        <i class="fas fa-chevron-left"></i>
                    </button>

                    <div id="thumbnail-scroll" class="d-flex gap-2 overflow-auto py-2" style="scroll-behavior: smooth;">
                        @foreach (var image in initialImages)
                        {
                            <button type="button" class="btn p-0 border-0 bg-transparent"
                                    onclick="changeMainImage('@image.Url')">
                                <img src="@image.Url" alt="Thumbnail" class="img-thumbnail"
                                     style="width: 80px; height: 80px; object-fit: cover;"
                                     onerror="this.onerror=null; this.src='@placeholderUrl';" />
                            </button>
                        }
                    </div>

                    <button type="button"
                            class="btn btn-light position-absolute top-50 end-0 translate-middle-y shadow-sm"
                            style="z-index: 1;" onclick="scrollGallery(1)" aria-label="Next image">
                        <i class="fas fa-chevron-right"></i>
                    </button>
                </div>
            </div>

            <div class="col-lg-7">
                <small class="text-muted text-uppercase">@product.BrandName</small>

                <h1 class="display-5 fw-bold mb-3">@product.Name</h1>

                @if (!string.IsNullOrWhiteSpace(product.ShortDescription))
                {
                    <p class="lead text-muted mb-4">@product.ShortDescription</p>
                }

                <div class="mb-4">
                    <div class="d-flex align-items-center gap-3 flex-wrap">
                        <span id="price" class="fs-2 fw-bold">
                            @(selectedVariant?.Price.ToString("C") ?? "N/A")
                        </span>

                        <span id="compare-price" class="text-muted text-decoration-line-through"></span>
                        <span id="discount-badge" class="badge bg-danger"></span>
                    </div>
                </div>

                @if (!string.IsNullOrWhiteSpace(product.Description))
                {
                    <div class="mb-4">
                        <p class="text-muted">@product.Description</p>
                    </div>
                }

                <div class="mb-4 pb-4 border-bottom">
                    <span id="stock-status" class="fw-semibold"></span>
                    <div id="variant-sku" class="small text-muted mt-1"></div>
                </div>

                @if (product.Attributes.Any())
                {
                    <div class="mb-4 pb-4 border-bottom">
                        <h5 class="fw-bold mb-3">Choose Options</h5>

                        <div class="d-flex flex-column gap-4">
                            @foreach (var optionGroup in product.Attributes)
                            {
                                <fieldset>
                                    <legend class="h6 fw-semibold mb-2">@optionGroup.Name</legend>

                                    <div class="d-flex flex-wrap gap-2">
                                        @foreach (var value in optionGroup.Values)
                                        {
                                            var isChecked = selectedAttributeValueIds.Contains(value.Id);
                                            var inputId = $"attribute-{optionGroup.Id}-{value.Id}";

                                            <input id="@inputId" type="radio" class="btn-check variant-option"
                                                   name="option-@optionGroup.Id" value="@value.Id" data-attribute-id="@optionGroup.Id"
                                                   autocomplete="off" @(isChecked ? "checked" : "") />
                                            <label for="@inputId" class="btn btn-outline-secondary rounded-pill px-3">
                                                @value.Value
                                            </label>
                                        }
                                    </div>
                                </fieldset>
                            }
                        </div>

                        <div id="variant-warning" class="alert alert-warning mt-4 mb-0 d-none">
                            This combination is not available. Choose a different option.
                        </div>
                    </div>
                }

                <div class="mb-4 pb-4 border-bottom">
                    <h5 class="fw-bold mb-3">Quantity</h5>

                    <div class="d-flex align-items-center gap-2" style="width: fit-content;">
                        <button id="decrease-quantity" type="button" class="btn btn-light border" style="width: 42px"
                                onclick="decreaseQuantity()">
                            -
                        </button>

                        <input id="quantity-input" type="number" min="1" value="1" class="form-control text-center"
                               style="width: 72px;" />

                        <button id="increase-quantity" type="button" class="btn btn-light border" style="width: 42px"
                                onclick="increaseQuantity()">
                            +
                        </button>
                    </div>
                </div>

                <div class="d-flex gap-3 mb-4">
                    <button id="add-to-cart-button" class="btn btn-primary-gradient flex-grow-1 py-3 fw-bold"
                            type="button">
                        <i class="fas fa-shopping-cart me-2"></i>
                        Add to Cart
                    </button>

                    <button class="btn btn-outline-secondary px-4" type="button">
                        <i class="fas fa-heart"></i>
                    </button>
                </div>
            </div>
        </div>
    </div>
</section>

<script>
    const variants = @Html.Raw(variantsJson);
    const placeholderUrl = '@placeholderUrl';
    let selectedVariant = null;

    function formatMoney(value) {
        return Number(value || 0).toLocaleString(undefined, {
            style: 'currency',
            currency: 'USD'
        });
    }

    function getSelectedAttributeValueIds() {
        return Array
            .from(document.querySelectorAll('.variant-option:checked'))
            .map(input => input.value)
            .sort();
    }

    function findMatchingVariant() {
        const selectedValues = getSelectedAttributeValueIds();

        return variants.find(variant => {
            const variantValues = variant.attributes
                .map(attribute => String(attribute.attributeValueId))
                .sort();

            return selectedValues.length === variantValues.length &&
                selectedValues.every((value, index) => value === variantValues[index]);
        }) || null;
    }

    function changeMainImage(url) {
        document.getElementById('main-product-image').src = url || placeholderUrl;
    }

    function renderThumbnails(images) {
        const container = document.getElementById('thumbnail-scroll');
        const safeImages = images && images.length > 0
            ? images
            : [{ url: placeholderUrl }];

        container.innerHTML = safeImages
            .map(image => `
                <button type="button" class="btn p-0 border-0 bg-transparent" onclick="changeMainImage('${image.url}')">
                    <img src="${image.url}" alt="Thumbnail" class="img-thumbnail" style="width: 80px; height: 80px; object-fit: cover;" onerror="this.onerror=null; this.src='${placeholderUrl}';" />
                </button>
            `)
            .join('');

        const primaryImage = safeImages.find(image => image.isPrimary) || safeImages[0];
        changeMainImage(primaryImage.url);
    }

    function updatePrice(variant) {
        document.getElementById('price').textContent = formatMoney(variant.price);

        const compareEl = document.getElementById('compare-price');
        const discountEl = document.getElementById('discount-badge');

        if (variant.compareAtPrice && variant.compareAtPrice > variant.price) {
            compareEl.textContent = formatMoney(variant.compareAtPrice);
            compareEl.classList.remove('d-none');

            const discount = variant.discountPercentage
                ? Math.round(variant.discountPercentage)
                : Math.round(((variant.compareAtPrice - variant.price) / variant.compareAtPrice) * 100);

            discountEl.textContent = `Save ${discount}%`;
            discountEl.classList.remove('d-none');
        } else {
            compareEl.classList.add('d-none');
            discountEl.classList.add('d-none');
        }
    }

    function updateStockState(variant) {
        const stockStatus = document.getElementById('stock-status');
        const sku = document.getElementById('variant-sku');
        const addToCart = document.getElementById('add-to-cart-button');
        const quantity = document.getElementById('quantity-input');
        const decrease = document.getElementById('decrease-quantity');
        const increase = document.getElementById('increase-quantity');
        const warning = document.getElementById('variant-warning');

        if (!variant) {
            stockStatus.className = 'text-warning fw-semibold';
            stockStatus.innerHTML = '<i class="fas fa-exclamation-circle me-2"></i>Unavailable combination';
            sku.textContent = '';
            addToCart.disabled = true;
            quantity.disabled = true;
            decrease.disabled = true;
            increase.disabled = true;
            warning?.classList.remove('d-none');
            return;
        }

        warning?.classList.add('d-none');
        sku.textContent = variant.sku ? `SKU: ${variant.sku}` : '';

        if (variant.isPurchasable) {
            stockStatus.className = 'text-success fw-semibold';
            stockStatus.innerHTML = `<i class="fas fa-check-circle me-2"></i>In Stock (${variant.stock} available)`;
            addToCart.disabled = false;
            quantity.disabled = false;
            decrease.disabled = false;
            increase.disabled = false;
            quantity.max = variant.stock;
            quantity.value = Math.min(Math.max(parseInt(quantity.value || '1'), 1), variant.stock);
        } else if (variant.stock <= 0) {
            stockStatus.className = 'text-danger fw-semibold';
            stockStatus.innerHTML = '<i class="fas fa-times-circle me-2"></i>Out of Stock';
            addToCart.disabled = true;
            quantity.disabled = true;
            decrease.disabled = true;
            increase.disabled = true;
            quantity.value = 1;
        } else {
            stockStatus.className = 'text-warning fw-semibold';
            stockStatus.innerHTML = '<i class="fas fa-exclamation-circle me-2"></i>Currently unavailable';
            addToCart.disabled = true;
            quantity.disabled = true;
            decrease.disabled = true;
            increase.disabled = true;
            quantity.value = 1;
        }
    }

    function updateVariantUI() {
        selectedVariant = findMatchingVariant();

        if (selectedVariant) {
            updatePrice(selectedVariant);
            renderThumbnails(selectedVariant.images);
        }

        updateStockState(selectedVariant);
    }

    function scrollGallery(direction) {
        document.getElementById('thumbnail-scroll')?.scrollBy({
            left: direction * 120,
            behavior: 'smooth'
        });
    }

    function increaseQuantity() {
        if (!selectedVariant?.isPurchasable) {
            return;
        }

        const input = document.getElementById('quantity-input');
        const current = parseInt(input.value || '1');
        input.value = Math.min(current + 1, selectedVariant.stock);
    }

    function decreaseQuantity() {
        const input = document.getElementById('quantity-input');
        const current = parseInt(input.value || '1');

        if (current > 1) {
            input.value = current - 1;
        }
    }

    document.addEventListener('DOMContentLoaded', () => {
        document
            .querySelectorAll('.variant-option')
            .forEach(input => input.addEventListener('change', updateVariantUI));

        document.getElementById('quantity-input')?.addEventListener('input', event => {
            if (!selectedVariant?.isPurchasable) {
                event.target.value = 1;
                return;
            }

            const quantity = parseInt(event.target.value || '1');
            event.target.value = Math.min(Math.max(quantity, 1), selectedVariant.stock);
        });

        document.getElementById('add-to-cart-button')?.addEventListener('click', () => {
            if (!selectedVariant?.isPurchasable) {
                return;
            }
        });

        updateVariantUI();
    });
</script>
