@model RetailCore.Shared.DTOs.Product.ProductSummaryDto

@{
    var imageUrl = string.IsNullOrWhiteSpace(Model.ThumbnailUrl)
        ? Url.Content("~/assets/images/placeholder.svg")
        : Model.ThumbnailUrl;

    var compareAtPrice = Model.CompareAtPrice ?? 0;
    var hasDiscount =
        Model.CompareAtPrice.HasValue &&
        compareAtPrice > Model.Price;
}

<div class="card product-card card-hover h-100 border-0 shadow-sm">
    <!-- Image -->
    <div class="img-container position-relative overflow-hidden">
        <img
            src="@imageUrl"
            alt="@Model.Name"
            class="card-img-top"
            style="height: 280px; object-fit: cover;"
            onerror="this.onerror=null; this.src='@Url.Content("~/assets/images/placeholder.svg")';"
        />

        @if (hasDiscount && Model.DiscountPercentage.HasValue)
        {
            <div
                class="position-absolute top-0 end-0 m-3 badge bg-danger"
            >
                -@Math.Round(Model.DiscountPercentage.Value)%
            </div>
        }

        @if (Model.IsOutOfStock)
        {
            <div
                class="position-absolute top-0 start-0 m-3 badge bg-dark"
            >
                Out of Stock
            </div>
        }

        <div class="img-overlay"></div>
    </div>

    <!-- Content -->
    <div class="card-body d-flex flex-column">
        <!-- Brand -->
        <div class="d-flex align-items-center gap-2 mb-2">
            <small class="text-muted">@Model.BrandName</small>

            <button
                class="btn btn-light btn-sm rounded-circle ms-auto"
                type="button"
            >
                <i class="far fa-heart"></i>
            </button>
        </div>

        <!-- Name -->
        <h5 class="card-title line-clamp-2 mb-2">
            @Model.Name
        </h5>

        <!-- Category -->
        <p class="text-muted small mb-3">
            @Model.CategoryName
        </p>

        <!-- Price -->
        <div class="mb-3 mt-auto">
            <div class="d-flex align-items-center gap-2">
                <span class="fw-bold fs-5">
                    @Model.Price.ToString("C")
                </span>

                @if (hasDiscount)
                {
                    <small class="text-muted text-decoration-line-through">
                        @compareAtPrice.ToString("C")
                    </small>
                }
            </div>
        </div>

        <!-- Stock -->
        <div class="mb-3">
            @if (!Model.IsOutOfStock)
            {
                <small class="text-success fw-semibold">
                    In Stock
                </small>
            }
            else
            {
                <small class="text-danger fw-semibold">
                    Out of Stock
                </small>
            }
        </div>

        <!-- Actions -->
        <div class="d-flex gap-2">
            <a
                asp-page="/Products/Details"
                asp-route-slug="@Model.Slug"
                class="btn btn-primary flex-grow-1"
                style="background: var(--primary-gradient); border: none;"
            >
                View
            </a>

            <button
                class="btn btn-light flex-grow-1"
                type="button"
            >
                <i class="fas fa-shopping-cart"></i>
            </button>
        </div>
    </div>
</div>

<style>
    .img-container {
        position: relative;
    }

    .img-overlay {
        position: absolute;
        inset: 0;
        background: linear-gradient(
            to top,
            rgba(0, 0, 0, 0.4),
            transparent
        );

        opacity: 0;
        transition: opacity 0.3s ease;
    }

    .img-container:hover .img-overlay {
        opacity: 1;
    }

    .line-clamp-2 {
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }
</style>