@page
@model RetailCore.Customer.Pages.Auth.RegisterModel

@{
    ViewData["Title"] = "Register";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-12 col-md-7 col-lg-5">

            <div class="card border-0 shadow-lg rounded-4 overflow-hidden">

                <!-- Header -->
                <div class="bg-dark text-white text-center p-4">
                    <h2 class="fw-bold mb-1">Create Account</h2>
                    <p class="mb-0 text-light opacity-75">
                        Join RetailCore and start shopping
                    </p>
                </div>

                <!-- Body -->
                <div class="card-body p-4 p-lg-5">

                    @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
                    {
                        <div class="alert alert-danger rounded-3">
                            @Model.ErrorMessage
                        </div>
                    }

                    <form method="post">

                        <!-- Full Name -->
                        <div class="mb-4">
                            <label asp-for="Input.FullName" class="form-label fw-semibold"></label>

                            <input asp-for="Input.FullName" class="form-control form-control-lg rounded-3" />

                            <span asp-validation-for="Input.FullName" class="text-danger small"></span>
                        </div>

                        <!-- Email -->
                        <div class="mb-4">
                            <label asp-for="Input.Email" class="form-label fw-semibold"></label>

                            <input asp-for="Input.Email" class="form-control form-control-lg rounded-3" />

                            <span asp-validation-for="Input.Email" class="text-danger small"></span>
                        </div>

                        <!-- Password -->
                        <div class="mb-4">
                            <label asp-for="Input.Password" class="form-label fw-semibold"></label>

                            <input asp-for="Input.Password" type="password"
                                   class="form-control form-control-lg rounded-3" />

                            <span asp-validation-for="Input.Password" class="text-danger small"></span>
                        </div>

                        <!-- Submit -->
                        <button type="submit" class="btn btn-dark btn-lg w-100 rounded-3 fw-semibold">
                            Register
                        </button>

                    </form>

                    <!-- Divider -->
                    <div class="text-center my-4">
                        <span class="text-muted">Already have an account?</span>
                    </div>

                    <!-- Login Link -->
                    <a asp-page="/Auth/Login" class="btn btn-outline-dark btn-lg w-100 rounded-3">
                        Sign In
                    </a>

                </div>
            </div>

        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
